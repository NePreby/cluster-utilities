#!/usr/bin/env bash
# fleet-disks — inventory every internal disk on fleet hosts, including partitions that aren't mounted.
#
# Unmounted partitions can only be read as root. In host mode it asks for your sudo password ONCE,
# then runs unattended (a host that rejects that password gets one more prompt).
# Everything is READ-ONLY: each unmounted partition is mounted with `ro` (ext4: `ro,noload`, so not even
# the journal is replayed; NTFS: ntfs3 `ro`, falling back to ntfs-3g `ro`), inspected, then unmounted.
# Nothing is written to any data partition, and no fsck is run.
#
#   fleet-disks lab3 lab7 …     from the laptop: ask for the sudo password once, then copy this script
#                               to each host, run it there as root (`sudo -S`, password on ssh's stdin),
#                               and save the reports to ./fleet-disks-<date>/<host>.txt
#   fleet-disks --list          no root: lsblk overview of THIS host only (what's mounted, sizes)
#   sudo fleet-disks --scan     the root-side scan of THIS host (what the remote mode runs)
#
# Env: FLEET_DISKS_DRY=1 with --scan: no root, no mounting; only shows what would be scanned.
#      FLEET_DISKS_DU_TIMEOUT (seconds per partition for the per-folder `du`, default 120; 0 skips du).
set -u

list() {
  echo "== $(hostname)  $(date '+%F %T')"
  lsblk -o NAME,SIZE,ROTA,TRAN,MODEL,FSTYPE,LABEL,MOUNTPOINT,FSAVAIL,FSUSE% -e7,11,252
}

scan() {
  local dry=${FLEET_DISKS_DRY:-0}
  [ "$(id -u)" = 0 ] || [ "$dry" = 1 ] || { echo "--scan needs root (sudo)"; exit 1; }
  local du_t=${FLEET_DISKS_DU_TIMEOUT:-120}
  base=/run/fleet-disks.$$   # global on purpose: the EXIT trap runs after scan() has returned
  mkdir -p "$base"
  # Unmount whatever we mounted, even on Ctrl-C.
  trap 'for m in "$base"/*; do mountpoint -q "$m" && umount "$m"; rmdir "$m" 2>/dev/null; done; rmdir "$base" 2>/dev/null' EXIT
  list
  echo
  echo "== SMART health"
  if command -v smartctl >/dev/null; then
    for d in $(lsblk -dno PATH -e7,11,252 | grep -v zram); do
      printf '%s: %s\n' "$d" "$(smartctl -H "$d" 2>/dev/null | grep -iE 'overall-health|SMART Health Status' | sed 's/.*: *//')"
    done
  else
    echo "smartctl not installed (pacman -S smartmontools), skipped"
  fi
  # -P prints KEY="value" pairs, so empty fields and labels with spaces parse correctly.
  lsblk -Ppno NAME,TYPE,FSTYPE,SIZE,LABEL,MOUNTPOINT -e7,11,252 | while read -r line; do
    local NAME="" TYPE="" FSTYPE="" SIZE="" LABEL="" MOUNTPOINT=""
    eval "$line"
    local dev=$NAME type=$TYPE fs=$FSTYPE size=$SIZE label=$LABEL mnt=$MOUNTPOINT
    [ "$type" = part ] || [ "$type" = disk ] || continue
    case "$fs" in ext2|ext3|ext4|ntfs|btrfs|xfs|exfat|vfat) ;; *) continue ;; esac
    [ "$label" = "" ] && label="-"
    echo
    echo "======== $dev  fs=$fs  size=$size  label=$label"
    local m="$mnt" ours=0
    if [ -z "$m" ] && [ "$dry" = 1 ]; then echo "  (dry run: would mount read-only)"; continue; fi
    if [ -z "$m" ]; then
      m="$base/$(basename "$dev")"; mkdir -p "$m"
      case "$fs" in
        ext*) mount -o ro,noload "$dev" "$m" ;;
        ntfs) mount -t ntfs3 -o ro "$dev" "$m" 2>/dev/null || mount -t ntfs-3g -o ro "$dev" "$m" ;;
        *)    mount -o ro "$dev" "$m" ;;
      esac || { echo "  could not mount read-only, skipped"; rmdir "$m"; continue; }
      ours=1; echo "  (not mounted on this host; mounted read-only just for this scan)"
    else
      # btrfs subvolumes give lsblk several mountpoints and it shows one at random; prefer the real ones.
      for t in / /home; do findmnt -rn -o SOURCE "$t" 2>/dev/null | grep -q "^$dev\(\[\|$\)" && m=$t && break; done
      echo "  mounted at $m"
    fi
    df -h --output=size,used,avail,pcent "$m" | sed 's/^/  /'
    echo "  -- top level (owner, modified, name)"
    find "$m" -mindepth 1 -maxdepth 1 -printf '  %u\t%TY-%Tm-%Td\t%f\n' 2>/dev/null | sort -k3 | head -60
    [ -d "$m/Users" ] && { echo "  -- Windows user folders"; ls -1 "$m/Users" 2>/dev/null | sed 's/^/    /'; }
    [ -d "$m/home" ] && { echo "  -- Linux home folders"; ls -1 "$m/home" 2>/dev/null | sed 's/^/    /'; }
    if [ "$du_t" != 0 ] && [ "$fs" != vfat ]; then
      echo "  -- sizes of top-level folders (du, up to ${du_t}s; incomplete if it times out)"
      timeout "$du_t" nice -n 19 ionice -c3 du -xsh "$m"/* "$m"/.[!.]* 2>/dev/null | sort -rh | head -25 | sed "s|$m/||; s/^/    /"
    fi
    if [ "$ours" = 1 ]; then umount "$m" && rmdir "$m"; fi
  done
}

remote() {
  local out="fleet-disks-$(date +%F)" pw="" hpw="" tmp="/tmp/fleet-disks.$$" ok=() failed=()
  mkdir -p "$out"
  # Ask once. The password goes to each host on ssh's stdin, into `sudo -S`: never on a command line
  # (so not in `ps`), never on disk. Assumes the same sudo password on every host; a host that rejects
  # it gets one more prompt (Enter or 10 min of silence skips it).
  read -rsp "sudo password (used for every host): " pw; echo
  for h in "$@"; do
    echo "######## $h"
    hpw=$pw
    if ! printf '%s\n' "$hpw" | ssh -o BatchMode=yes "$h" "sudo -S -p '' -v" 2>/dev/null; then
      read -rs -t 600 -p "  $h rejected it; password for $h (Enter to skip): " hpw; echo
      [ -n "$hpw" ] && printf '%s\n' "$hpw" | ssh -o BatchMode=yes "$h" "sudo -S -p '' -v" 2>/dev/null \
        || { echo "  $h: skipped (no valid password)"; failed+=("$h"); continue; }
    fi
    scp -q "$0" "$h:$tmp" || { echo "  $h: copy failed, skipped"; failed+=("$h"); continue; }
    printf '%s\n' "$hpw" | ssh -o BatchMode=yes "$h" \
      "sudo -S -p '' env FLEET_DISKS_DU_TIMEOUT=${FLEET_DISKS_DU_TIMEOUT:-120} bash $tmp --scan; rm -f $tmp" \
      > "$out/$h.txt" 2>&1 && ok+=("$h") || failed+=("$h")
    echo "  done: $out/$h.txt ($(grep -c '^========' "$out/$h.txt") partitions)"
  done
  pw=""; hpw=""
  echo "reports: $out/   ok: ${ok[*]:-none}   failed/skipped: ${failed[*]:-none}"
}

case "${1:-}" in
  --list) list ;;
  --scan) scan ;;
  ""|-h|--help) sed -n '2,17p' "$0" ;;
  *) remote "$@" ;;
esac
